set(source "$ENV{IDF_PATH}/components/bt/host/bluedroid/btc/profile/std/hid/btc_hh.c")
file(READ "${source}" content)
string(REPLACE "\r\n" "\n" content "${content}")
string(SHA256 hash "${content}")
if(NOT hash STREQUAL "e348f93c7cc9cca7ecc8b20607bfdca0cfcf32bba876efe04862387a855467b9")
    message(FATAL_ERROR "Classic HID input overlay requires the pinned ESP-IDF v5.5.1 btc_hh.c")
endif()
set(original "BTA_HhOpen(arg->connect.bd_addr, BTA_HH_PROTO_RPT_MODE, (BTA_SEC_AUTHENTICATE | BTA_SEC_ENCRYPT));")
set(replacement "BTA_HhOpen(arg->connect.bd_addr, BTA_HH_PROTO_RPT_MODE, hub_esp_allow_open_input(arg->connect.bd_addr) ? BTA_SEC_NONE : BTA_SEC_ENCRYPT);")
string(FIND "${content}" "${original}" found)
if(found LESS 0)
    message(FATAL_ERROR "Pinned Classic HID connect call not found")
endif()
string(REPLACE "${original}" "${replacement}" content "${content}")
set(enable_original "BTA_HhEnable(BTA_SEC_AUTHENTICATE | BTA_SEC_ENCRYPT, bte_hh_evt);")
string(FIND "${content}" "${enable_original}" found)
if(found LESS 0)
    message(FATAL_ERROR "Pinned Classic HID host registration not found")
endif()
string(REPLACE "${enable_original}" "BTA_HhEnable(BTA_SEC_ENCRYPT, bte_hh_evt);" content "${content}")
set(content "extern _Bool hub_esp_allow_open_input(const unsigned char address[6]);\n${content}")
set(generated "${CMAKE_BINARY_DIR}/generated/btc_hh.c")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated")
file(WRITE "${generated}" "${content}")
idf_component_get_property(bt_target bt COMPONENT_LIB)
get_target_property(sources ${bt_target} SOURCES)
set(updated)
set(count 0)
foreach(item IN LISTS sources)
    if(item MATCHES "(^|/)btc_hh\\.c$")
        list(APPEND updated "${generated}")
        math(EXPR count "${count}+1")
    else()
        list(APPEND updated "${item}")
    endif()
endforeach()
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one original Classic HID host source, got ${count}")
endif()
set_property(TARGET ${bt_target} PROPERTY SOURCES "${updated}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
