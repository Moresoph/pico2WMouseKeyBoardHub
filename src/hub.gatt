PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ | DYNAMIC,
CHARACTERISTIC, GAP_APPEARANCE, READ, C0 03

PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_DEVICE_INFORMATION
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_MODEL_NUMBER_STRING, READ, Pico 2 W Bluetooth Hub
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_FIRMWARE_REVISION_STRING, READ, 0.4.3 feasibility
// Match this RP2350 prototype's Pico SDK USB identity; not a new product allocation.
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_PNP_ID, READ, 02 8A 2E 09 00 00 01

// HOGP companion service: this USB-powered prototype reports a fixed full level.
PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_BATTERY_SERVICE
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_BATTERY_LEVEL, READ, 64

// Report protocol only: deliberately no Boot reports or Protocol Mode.
PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_HUMAN_INTERFACE_DEVICE
CHARACTERISTIC, 2A4A, READ | READ_ENCRYPTED | ENCRYPTION_KEY_SIZE_16, 11 01 00 02
CHARACTERISTIC, 2A4B, READ | DYNAMIC | READ_ENCRYPTED | ENCRYPTION_KEY_SIZE_16,
CHARACTERISTIC, 2A4C, WRITE_WITHOUT_RESPONSE | DYNAMIC | WRITE_ENCRYPTED | ENCRYPTION_KEY_SIZE_16,

// WRITE_ENCRYPTED also protects the automatically generated notification CCCD.
// compile_gatt makes CCCD reads public; hub_output.c additionally checks their reads.
CHARACTERISTIC, 2A4D, READ | NOTIFY | DYNAMIC | READ_ENCRYPTED | WRITE_ENCRYPTED | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 01, 01
CHARACTERISTIC, 2A4D, READ | WRITE | WRITE_WITHOUT_RESPONSE | DYNAMIC | READ_ENCRYPTED | WRITE_ENCRYPTED | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 01, 02
CHARACTERISTIC, 2A4D, READ | NOTIFY | DYNAMIC | READ_ENCRYPTED | WRITE_ENCRYPTED | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 02, 01

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,
