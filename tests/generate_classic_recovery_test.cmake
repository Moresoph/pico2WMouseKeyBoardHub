cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/HubBtstackClassicRecovery.cmake")
hub_generate_classic_recovery("${BTSTACK_PATH}/src/classic/hid_host.c" "${OUTPUT_DIR}/hid_host.c" hid)
hub_generate_classic_recovery("${BTSTACK_PATH}/src/classic/sdp_client.c" "${OUTPUT_DIR}/sdp_client.c" sdp)
hub_generate_classic_recovery("${BTSTACK_PATH}/src/l2cap.c" "${OUTPUT_DIR}/l2cap.c" l2cap)
file(READ "${OUTPUT_DIR}/l2cap.c" source)
string(FIND "${source}" "bool hub_classic_l2cap_reap(" offset)
string(SUBSTRING "${source}" ${offset} -1 reap)
file(WRITE "${OUTPUT_DIR}/l2cap_reap.inc" "${reap}")
