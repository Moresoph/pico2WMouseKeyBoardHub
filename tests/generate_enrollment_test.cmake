file(READ "${ROOT}/esp32/main/main.c" source)
set(start "static esp_err_t persist_records(")
set(end "static void controls_task(")
string(FIND "${source}" "${start}" begin)
string(FIND "${source}" "${end}" finish)
if(begin LESS 0 OR finish LESS begin)
    message(FATAL_ERROR "Production input management test anchors missing")
endif()
math(EXPR size "${finish}-${begin}")
string(SUBSTRING "${source}" ${begin} ${size} management)
string(FIND "${source}" "static void remember_candidate(" begin)
string(FIND "${source}" "static void hid_event(" finish)
if(begin LESS 0 OR finish LESS begin)
    message(FATAL_ERROR "Production candidate test anchors missing")
endif()
math(EXPR size "${finish}-${begin}")
string(SUBSTRING "${source}" ${begin} ${size} discovery)
file(WRITE "${OUTPUT}" "${discovery}\n${management}")
