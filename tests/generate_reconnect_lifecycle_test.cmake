file(READ "${ROOT}/esp32/main/main.c" source)
string(FIND "${source}" "static void release_peer(" begin)
string(FIND "${source}" "static void reject_auth(peer_t *p) {" finish)
if(begin LESS 0 OR finish LESS begin)
    message(FATAL_ERROR "Production reconnect lifecycle test anchors missing")
endif()
math(EXPR size "${finish}-${begin}")
string(SUBSTRING "${source}" ${begin} ${size} lifecycle)
string(FIND "${source}" "static void hid_event(" begin)
string(FIND "${source}" "static void classic_gap(" finish)
if(begin LESS 0 OR finish LESS begin)
    message(FATAL_ERROR "Production HID callback test anchors missing")
endif()
math(EXPR size "${finish}-${begin}")
string(SUBSTRING "${source}" ${begin} ${size} callback)
file(WRITE "${OUTPUT}" "${lifecycle}\n${callback}")
