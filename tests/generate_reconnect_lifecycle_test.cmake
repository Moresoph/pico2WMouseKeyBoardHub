file(READ "${ROOT}/esp32/main/main.c" source)
string(FIND "${source}" "static void release_peer(" begin)
string(FIND "${source}" "static void reject_auth(peer_t *p) {" finish)
if(begin LESS 0 OR finish LESS begin)
    message(FATAL_ERROR "Production reconnect lifecycle test anchors missing")
endif()
math(EXPR size "${finish}-${begin}")
string(SUBSTRING "${source}" ${begin} ${size} lifecycle)
string(FIND "${source}" "static void hid_event(" begin)
string(FIND "${source}" "static void classic_gap(" finish)
if(begin LESS 0 OR finish LESS begin)
    message(FATAL_ERROR "Production HID callback test anchors missing")
endif()
math(EXPR size "${finish}-${begin}")
string(SUBSTRING "${source}" ${begin} ${size} callback)
string(FIND "${source}" "static void note_input(" begin)
string(FIND "${source}" "static void input_phase(" finish)
if(begin LESS 0 OR finish LESS begin)
    message(FATAL_ERROR "Production diagnostic recording anchors missing")
endif()
math(EXPR size "${finish}-${begin}")
string(SUBSTRING "${source}" ${begin} ${size} recording)
string(FIND "${source}" "static void request_mouse_interval(" begin)
string(FIND "${source}" "static void snapshot_locked(" finish)
if(begin LESS 0 OR finish LESS begin)
    message(FATAL_ERROR "Production mouse interval policy anchors missing")
endif()
math(EXPR size "${finish}-${begin}")
string(SUBSTRING "${source}" ${begin} ${size} mouse_policy)
string(REGEX MATCHALL "request_mouse_interval\\(p\\)" tuning_calls "${source}")
list(LENGTH tuning_calls tuning_count)
if(NOT tuning_count EQUAL 1 OR NOT callback MATCHES "if\\(mouse_activity\\)request_mouse_interval\\(p\\)")
    message(FATAL_ERROR "Fast interval must only be requested from actual mouse activity, not OPEN/auth/update callbacks")
endif()
file(WRITE "${OUTPUT}" "${recording}\n${mouse_policy}\n${lifecycle}\n${callback}")
