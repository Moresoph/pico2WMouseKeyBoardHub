file(READ "${ROOT}/esp32/main/hub_web.c" source)
string(FIND "${source}" "esp_err_t hub_web_init(" begin)
string(FIND "${source}" "static esp_err_t stop_locked(" finish)
if(begin LESS 0 OR finish LESS begin)
    message(FATAL_ERROR "Production web startup test anchors missing")
endif()
math(EXPR size "${finish}-${begin}")
string(SUBSTRING "${source}" ${begin} ${size} startup)
string(FIND "${source}" "esp_err_t hub_web_set_enabled(" begin)
if(begin LESS 0)
    message(FATAL_ERROR "Production web control test anchor missing")
endif()
string(SUBSTRING "${source}" ${begin} -1 controls)
file(WRITE "${OUTPUT}" "${startup}\n${controls}")
